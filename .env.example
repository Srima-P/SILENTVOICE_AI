# ─────────────────────────────────────────────
#  SilentVoice AI — Environment Configuration
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# Backend server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Frontend dev server
FRONTEND_PORT=5173

# CORS — comma-separated list of allowed origins
# Example: http://localhost:5173,http://127.0.0.1:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Phase 2 — Project to scan.
# Can be relative (resolved from the silentvoice-ai/ directory) or absolute.
# Default: the bundled demo project.
# To scan a different project: PROJECT_ROOT=/absolute/path/to/your/project
PROJECT_ROOT=demo_project

# Phase 3 — Groq AI Integration
# Get your key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Groq model to use for code explanation and analysis
GROQ_MODEL=openai/gpt-oss-20b

# Maximum file size (bytes) that can be sent to Groq. Default: 102400 (100 KB)
MAX_FILE_SIZE_FOR_AI=102400

# App metadata
APP_ENV=development
LOG_LEVEL=info
